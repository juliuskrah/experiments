# Hydra OIDC issuer + admin API (both reachable by the Next.js server only; the admin URL MUST
# never be reachable by the browser or public internet — see research.md §1)
HYDRA_ISSUER_URL=http://localhost:4444
HYDRA_ADMIN_URL=http://localhost:4445

# OAuth2 client registered with Hydra for this app
HYDRA_CLIENT_ID=hydra-kratos
HYDRA_CLIENT_SECRET=

# Key used to encrypt the session cookie (JWE via jose) — generate a strong random value
SESSION_SECRET=

# Kratos Public API base URL, used to render self-service login/registration/recovery flows and
# for the Hydra login bridge's /sessions/whoami check
KRATOS_PUBLIC_URL=http://localhost:4433

# Kratos Admin API base URL, used by the Hydra consent bridge to look up identity traits (email,
# name) for the ID token -- reachable only from the host, never the browser (see deploy/compose.yml)
KRATOS_ADMIN_URL=http://localhost:4434
