# Docker Compose stack secrets (deploy/compose.yml) — copy to deploy/.env and fill in.
# App-level variables consumed inside the container are documented in the repository root's
# .env.example; these are additional secrets required only by the Compose services themselves.

DEX_CLIENT_ID=dex-via-kratos
DEX_CLIENT_SECRET=
SESSION_SECRET=

# Kratos cookie/cipher secrets — each MUST be at least 32 characters.
KRATOS_COOKIE_SECRET=
KRATOS_CIPHER_SECRET=
