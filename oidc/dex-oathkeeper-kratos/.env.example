# Dex OIDC issuer, reached THROUGH Oathkeeper on the port Docker Compose publishes to the host
# (deploy/compose.yml). Run the app on the host (not in a container) so this resolves identically
# for both the browser and the app's own server-side openid-client discovery call — see
# deploy/dex/config.yaml's comment on why the issuer and this value must be the exact same URL.
DEX_ISSUER_URL=http://localhost:4455/dex

# OIDC client registered with Dex for this app
DEX_CLIENT_ID=dex-via-kratos
DEX_CLIENT_SECRET=

# Key used to encrypt the session cookie (JWE via jose) — generate a strong random value
SESSION_SECRET=

# Password for Kratos's Postgres role (deploy/compose.yml) — dev-only, rotatable
KRATOS_DB_PASSWORD=

# Kratos Public API base URL, used to render self-service login/registration/recovery flows
KRATOS_PUBLIC_URL=http://localhost:4433

# @ory/nextjs's middleware (middleware.ts) proxies same-origin /self-service/* requests to this
# URL -- must match KRATOS_PUBLIC_URL. Required by @ory/nextjs's createOryMiddleware.
ORY_SDK_URL=http://localhost:4433
